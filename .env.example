# Gemini AI API Key (server-side only; configure in Vercel Environment Variables or Settings > Secrets)
GEMINI_API_KEY=

# JWT Signing Secret (REQUIRED on Vercel: use a 32+ character random hex string so sessions persist across serverless invocations)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=2h

# Option A (Recommended for Vercel / Neon / Supabase / Vercel Postgres / Cloud SQL Public IP):
# Standard PostgreSQL connection URI. SSL is enabled automatically on Vercel for remote hosts.
DATABASE_URL=
DATABASE_SSL=

# Option B (AI Studio Cloud SQL runtime or discrete PostgreSQL parameters):
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_SSL=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional Firebase Admin overrides (for Google Sign-In token verification on Vercel)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
